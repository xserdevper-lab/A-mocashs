const PASSKEY_RP='xserdevper-lab.github.io';
const PASSKEY_ORIGIN='https://xserdevper-lab.github.io';
function pkBytes_(text,max){if(typeof text!=='string'||!text||text.length>max*2||!/^[A-Za-z0-9_-]+$/.test(text))throw new Error('ข้อมูล Passkey ไม่ถูกต้อง');const bytes=new Uint8Array(Utilities.base64DecodeWebSafe(text).map(b=>(b+256)%256));if(bytes.length>max||pkEncode_(bytes)!==text)throw new Error('ข้อมูล Passkey ไม่ถูกต้อง');return bytes;}
function pkSigned_(bytes){return Array.from(bytes,b=>b>127?b-256:b);}
function pkEncode_(bytes){return Utilities.base64EncodeWebSafe(pkSigned_(bytes)).replace(/=+$/,'');}
function pkHash_(bytes){return new Uint8Array(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,pkSigned_(bytes)).map(b=>(b+256)%256));}
function pkUtf8_(text){return new Uint8Array(Utilities.newBlob(String(text)).getBytes().map(b=>(b+256)%256));}
function pkEqual_(a,b){return a.length===b.length&&a.every((v,i)=>v===b[i]);}
function pkChallenge_(){return pkEncode_(pkHash_(pkUtf8_(Utilities.getUuid()+Utilities.getUuid()+Utilities.getUuid())));}
function pkClient_(encoded,type){const bytes=pkBytes_(encoded,4096);let client;try{client=JSON.parse(Utilities.newBlob(pkSigned_(bytes)).getDataAsString('UTF-8'));}catch{throw new Error('ข้อมูล Passkey ไม่ถูกต้อง');}if(client.type!==type||client.origin!==PASSKEY_ORIGIN||(client.crossOrigin!==undefined&&client.crossOrigin!==false)||(client.topOrigin&&client.topOrigin!==PASSKEY_ORIGIN)||typeof client.challenge!=='string'||!/^[A-Za-z0-9_-]{43}$/.test(client.challenge))throw new Error('ไม่สามารถยืนยัน Passkey ได้');return {client,bytes};}
function pkAuthData_(bytes,registration){if(bytes.length<37||!pkEqual_(bytes.slice(0,32),pkHash_(pkUtf8_(PASSKEY_RP))))throw new Error('ไม่สามารถยืนยัน Passkey ได้');const flags=bytes[32];if(!(flags&1)||!(flags&4)||((flags&16)&&!(flags&8))||Boolean(flags&64)!==registration)throw new Error('กรุณายืนยันด้วย PIN เครื่องหรือลายนิ้วมือ');const counter=new DataView(bytes.buffer,bytes.byteOffset,bytes.byteLength).getUint32(33,false);return {counter,flags};}
function pkRecords_(user){const all=PropertiesService.getScriptProperties().getProperties();return Object.keys(all).filter(key=>key.startsWith('PASSKEY_')).map(key=>({key,...JSON.parse(all[key])})).filter(record=>record.user.id===user.id);}
function listPasskeys(token){const user=session_(token);return pkRecords_(user).map(record=>({id:record.key,name:record.name,createdAt:record.createdAt}));}
function beginPasskeyRegistration(token){const user=session_(token);if(pkRecords_(user).length>=10)throw new Error('ลงทะเบียน Passkey ได้ไม่เกิน 10 รายการ');const challenge=pkChallenge_(),expiresAt=Date.now()+300000;CacheService.getScriptCache().put('pk:register:'+challenge,JSON.stringify({userId:user.id,session:digest_(token),expiresAt}),300);return {expiresAt,publicKey:{challenge,rp:{id:PASSKEY_RP,name:'A-mocashs'},user:{id:pkEncode_(pkUtf8_(user.id)),name:user.email,displayName:user.name},pubKeyCredParams:[{type:'public-key',alg:-7}],timeout:60000,attestation:'none',authenticatorSelection:{authenticatorAttachment:'platform',residentKey:'required',requireResidentKey:true,userVerification:'required'},excludeCredentials:pkRecords_(user).map(record=>({type:'public-key',id:record.credentialId,transports:record.transports}))}};}
function finishPasskeyRegistration(token,credential,name){
 const user=session_(token);if(credential?.type!=='public-key')throw new Error('ข้อมูล Passkey ไม่ถูกต้อง');const {client}=pkClient_(credential.response?.clientDataJSON,'webauthn.create');const cache=CacheService.getScriptCache(),requestKey='pk:register:'+client.challenge;
 const lock=LockService.getScriptLock();lock.waitLock(30000);try{
  const raw=cache.get(requestKey);cache.remove(requestKey);if(!raw)throw new Error('คำขอ Passkey หมดอายุ กรุณาลองอีกครั้ง');const request=JSON.parse(raw);if(request.expiresAt<=Date.now()||request.userId!==user.id||request.session!==digest_(token))throw new Error('ไม่มีสิทธิ์ลงทะเบียน Passkey นี้');
  const object=PasskeyCrypto.decode(pkBytes_(credential.response.attestationObject,16384));if(!(object instanceof Map)||object.get('fmt')!=='none'||!(object.get('attStmt') instanceof Map)||object.get('attStmt').size!==0)throw new Error('รูปแบบ Passkey นี้ยังไม่รองรับ');const data=object.get('authData');if(!(data instanceof Uint8Array))throw new Error('ข้อมูล Passkey ไม่ถูกต้อง');const {counter,flags}=pkAuthData_(data,true);if(data.length<55)throw new Error('ข้อมูล Passkey ไม่ถูกต้อง');const length=(data[53]<<8)|data[54];if(length<1||length>1024||55+length>=data.length)throw new Error('ข้อมูล Passkey ไม่ถูกต้อง');const rawId=pkBytes_(credential.rawId,1024),credentialId=pkEncode_(data.slice(55,55+length));if(credential.id!==credentialId||pkEncode_(rawId)!==credentialId)throw new Error('ข้อมูล Passkey ไม่ถูกต้อง');
  const [cose,consumed]=PasskeyCrypto.decodePartial(data.slice(55+length));if(!(cose instanceof Map)||cose.get(1)!==2||cose.get(3)!==-7||cose.get(-1)!==1)throw new Error('รูปแบบ Passkey นี้ยังไม่รองรับ');const x=cose.get(-2),y=cose.get(-3);if(!(x instanceof Uint8Array)||!(y instanceof Uint8Array)||x.length!==32||y.length!==32)throw new Error('ข้อมูล Passkey ไม่ถูกต้อง');const end=55+length+consumed;if(flags&128){PasskeyCrypto.decode(data.slice(end));}else if(end!==data.length)throw new Error('ข้อมูล Passkey ไม่ถูกต้อง');const publicKey=new Uint8Array(65);publicKey[0]=4;publicKey.set(x,1);publicKey.set(y,33);PasskeyCrypto.validKey(publicKey);
  const properties=PropertiesService.getScriptProperties(),key='PASSKEY_'+digest_(credentialId);if(properties.getProperty(key)||pkRecords_(user).length>=10)throw new Error('Passkey นี้ลงทะเบียนแล้วหรือครบจำนวนที่รองรับ');
  const transports=(Array.isArray(credential.response.transports)?credential.response.transports:[]).filter(t=>['internal','hybrid','usb','nfc','ble'].includes(t));const record={credentialId,publicKey:pkEncode_(publicKey),counter,user:{id:user.id,email:user.email,name:user.name},name:String(name||'Passkey').trim().slice(0,80)||'Passkey',createdAt:new Date().toISOString(),transports};properties.setProperty(key,JSON.stringify(record));return listPasskeys(token);
 }finally{lock.releaseLock();}
}
function beginPasskeyAuthentication(){const challenge=pkChallenge_(),expiresAt=Date.now()+300000;CacheService.getScriptCache().put('pk:login:'+challenge,JSON.stringify({expiresAt}),300);return {expiresAt,publicKey:{challenge,rpId:PASSKEY_RP,timeout:60000,userVerification:'required'}};}
function authenticatePasskey(credential){
 if(credential?.type!=='public-key')throw new Error('ข้อมูล Passkey ไม่ถูกต้อง');const {client,bytes:clientData}=pkClient_(credential.response?.clientDataJSON,'webauthn.get');const lock=LockService.getScriptLock();lock.waitLock(30000);try{
  const cache=CacheService.getScriptCache(),requestKey='pk:login:'+client.challenge,raw=cache.get(requestKey);cache.remove(requestKey);if(!raw||JSON.parse(raw).expiresAt<=Date.now())throw new Error('คำขอ Passkey หมดอายุ กรุณาลองอีกครั้ง');const id=pkEncode_(pkBytes_(credential.rawId,1024));if(credential.id!==id)throw new Error('ข้อมูล Passkey ไม่ถูกต้อง');const properties=PropertiesService.getScriptProperties(),key='PASSKEY_'+digest_(id),stored=properties.getProperty(key);if(!stored)throw new Error('Passkey นี้ไม่มีสิทธิ์เข้าแอป');const record=JSON.parse(stored),members=JSON.parse(properties.getProperty('MEMBER_EMAILS')||'[]'),sub=properties.getProperty('MEMBER_SUB_'+digest_(record.user.email));if(!members.includes(record.user.email)||!sub||digest_(sub).slice(0,24)!==record.user.id)throw new Error('บัญชีนี้ไม่มีสิทธิ์เข้าใช้แอป');
  const handle=pkBytes_(credential.response.userHandle,64);if(!pkEqual_(handle,pkUtf8_(record.user.id)))throw new Error('ไม่สามารถยืนยัน Passkey ได้');const data=pkBytes_(credential.response.authenticatorData,4096),{counter,flags}=pkAuthData_(data,false);if(flags&128){PasskeyCrypto.decode(data.slice(37));}else if(data.length!==37)throw new Error('ข้อมูล Passkey ไม่ถูกต้อง');const message=new Uint8Array(data.length+32);message.set(data);message.set(pkHash_(clientData),data.length);const signature=pkBytes_(credential.response.signature,128);if(!PasskeyCrypto.verify(signature,message,pkBytes_(record.publicKey,65)))throw new Error('ไม่สามารถยืนยัน Passkey ได้');if((record.counter||counter)&&counter<=record.counter)throw new Error('Passkey ไม่ผ่านการตรวจสอบการใช้งานซ้ำ');record.counter=counter;properties.setProperty(key,JSON.stringify(record));return createSession_(record.user,key);
 }finally{lock.releaseLock();}
}
function revokePasskey(token,id){const user=session_(token);if(typeof id!=='string'||!/^PASSKEY_[a-f0-9]{64}$/.test(id))throw new Error('ไม่มีสิทธิ์ลบ Passkey นี้');const lock=LockService.getScriptLock();lock.waitLock(30000);try{const properties=PropertiesService.getScriptProperties(),raw=properties.getProperty(id);if(!raw)return true;if(JSON.parse(raw).user.id!==user.id)throw new Error('ไม่มีสิทธิ์ลบ Passkey นี้');properties.deleteProperty(id);return true;}finally{lock.releaseLock();}}
